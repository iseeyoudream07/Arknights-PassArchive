# Non-secret deployment settings. Copy to deploy/.env and edit for your server.
PASSARCHIVE_HOST=passarchive.example
PASSARCHIVE_ORIGIN=https://passarchive.example
PASSARCHIVE_API_PORT=18082
PASSARCHIVE_WEB_PORT=18083
# Use prebuilt only after building or extracting a verified Release into web/dist.
PASSARCHIVE_WEB_BUILD_TARGET=web
PASSARCHIVE_SECRET_DIR=/srv/passarchive/secrets
PASSARCHIVE_VERSION=0.4.5
